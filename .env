# Web app config (e.g. /tocky for prod)
# Where static assets/etc/main web app is served from
TOCKY_PUBLIC_URL='http://localhost:5000/tocky'
# How the web app accesses itself internally
TOCKY_INTERNAL_URL='http://localhost:5000/tocky'

# Where various caches are stored
TOCKY_DISK_CACHE=/tmp/tocky_cache

# DB config
TOCKY_QUEUE_DB_PATH=/path/to/your/sqlite.db

# API Keys for the tocky app
# Admin access basically
TOCKY_SERVER_KEY='***'
# Normal user access
TOCKY_USER_KEY='***'

# Third-party service keys
AZURE_SUBSCRIPTION_KEY='***'
AZURE_ENDPOINT=https://YOUR_HOST.cognitiveservices.azure.com/
OPENAI_API_KEY='sk-***'
GEMINI_API_KEY="..."
IA_CONFIG_FILE="/path/to/your/ia_config.ini"
