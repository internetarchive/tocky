# Web app config (e.g. /tocky for prod)
TOCKY_APPLICATION_ROOT=''
TOCKY_SERVER_NAME='127.0.0.1:5000'
TOCKY_PREFERRED_URL_SCHEME='http'

# DB config
TOCKY_QUEUE_DB_PATH=/path/to/your/sqlite.db

# API Keys for the tocky app
# Admin access basically
TOCKY_SERVER_KEY='***'
# Normal user access
TOCKY_USER_KEY='***'

# Third-party service keys
AZURE_SUBSCRIPTION_KEY='***'
AZURE_ENDPOINT=https://YOUR_HOST.cognitiveservices.azure.com/
OPENAI_API_KEY='sk-***'
IA_CONFIG_FILE="/path/to/your/ia_config.ini"
